<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="miContenedor" prefWidth="585.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.sysventas.controller.UsuarioController">
    <children>
        <VBox spacing="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">

            <!-- Título -->
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="PROVEEDOR LIB BARNERY" />

            <!-- Formulario -->
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="30" />
                    <ColumnConstraints percentWidth="70" />
                </columnConstraints>

                <children>
                    <Label text="Usuario:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="txtUser" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Clave:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <PasswordField fx:id="txtClave" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Perfil:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <ComboBox fx:id="cbxPerfil" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                </children>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <!-- Botones de acción -->
            <HBox alignment="CENTER_LEFT" prefHeight="25.0" prefWidth="392.0" spacing="10">
                <children>
                    <Button fx:id="btnNuevo" onAction="#clearForm" text="Nuevo" />
                    <Button fx:id="btnGuardar" onAction="#validarFormulario" text="Guardar" />
                    <Button fx:id="btnEditar" onAction="#listar" text="Editar" />
                    <Button fx:id="btnEliminar" onAction="#listar" text="Eliminar" />
                </children>
            </HBox>

            <!-- Filtro de búsqueda -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <children>
                    <Label text="Buscar:" />
                    <TextField fx:id="txtFiltroDato" promptText="Ingrese texto para filtrar..." />
                </children>
            </HBox>

            <!-- Tabla de usuarios -->
            <TableView fx:id="tableView" prefHeight="300" />

            <!-- Mensaje -->
            <Label fx:id="lbnMsg" style="-fx-text-fill: red;" text="" />

        </VBox>
      <ImageView fitHeight="102.0" fitWidth="201.0" layoutX="288.0" layoutY="124.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../img/png-transparent-management-consulting-vendor-business-consultant-business-service-people-logo.png" />
         </image>
      </ImageView>
    </children>

    <!-- Margen interior general -->
    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>
</AnchorPane>
